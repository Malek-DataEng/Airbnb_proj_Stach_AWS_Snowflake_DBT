# ============================================================================
# .gitignore proposé pour Airbnb_proj_Stach_AWS_Snowflake_DBT
# Écrit le 05/08/2026. À déposer à la racine du dépôt sous le nom .gitignore
#
# ATTENTION : ajouter ce fichier n'efface pas ce qui est DÉJÀ suivi par Git.
# Les commandes de nettoyage sont dans le README de ce dossier.
# ============================================================================

# ---------------------------------------------------------------------------
# dbt
# ---------------------------------------------------------------------------
target/
dbt_packages/
dbt_modules/
logs/
.user.yml

# Profil de connexion : contient les identifiants Snowflake.
# Ne doit jamais être suivi, même vide.
profiles.yml

# ---------------------------------------------------------------------------
# Secrets et configuration locale
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
secrets.toml
.streamlit/secrets.toml
*.pem
*.p8
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Environnements virtuels
.venv/
venv/
env/
ENV/

# Outils de test et de qualité
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------------------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------------------
.ipynb_checkpoints/

# ---------------------------------------------------------------------------
# Éditeurs et environnements de développement
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------------------
# Systèmes d'exploitation
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Données volumineuses ou temporaires
# ---------------------------------------------------------------------------
*.parquet
*.duckdb
tmp/
temp/

# Exception : l'extrait de démonstration de l'application Streamlit doit être
# suivi, c'est lui qui rend la démo autonome et reproductible.
!streamlit/data/*.csv
